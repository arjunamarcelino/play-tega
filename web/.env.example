# Deployed Tega contract (zero until the deploy prompt wires it in)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect / Reown project id (REQUIRED by getDefaultConfig) — free at cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# NOTE: the web app uses the public Monad RPC hardcoded in lib/monadChain.ts.
# If you later switch to a keyed provider (QuickNode/Ankr), the keyed URL must be
# consumed SERVER-SIDE only — NEVER prefix an authenticated RPC URL with NEXT_PUBLIC_,
# or the API key ships in client JS to every visitor.
