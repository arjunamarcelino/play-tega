# Deployed Tega contract (zero until the deploy prompt wires it in)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect / Reown project id (REQUIRED by getDefaultConfig) — free at cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Staked token (USDC) address — set per network. Unset → devnads testnet USDC.
#   testnet (devnads): 0x56bf9CDc3C1876F3F22655a0016C2743E9e39a73
#   mainnet:           0x754704Bc059F8C67012fEd69BC8A327a5aafb603
NEXT_PUBLIC_USDC_ADDRESS=0x56bf9CDc3C1876F3F22655a0016C2743E9e39a73
# Optional — both testnet & mainnet USDC are 6-dec, so leave unset unless the token differs.
# NEXT_PUBLIC_USDC_DECIMALS=6

# Faucet URL for test USDC. Set it on testnet/dev to show "Mint USDC" links.
# LEAVE EMPTY in production — the app shows NO faucet UI when this is unset (fail-closed).
NEXT_PUBLIC_FAUCET_URL=https://devnads.com/tokens

# Block explorer base — makes the deployed contract + tx hashes clickable.
#   testnet: https://testnet.monadvision.com   mainnet: https://monadvision.com
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com

# NOTE: the web app uses the public Monad RPC hardcoded in lib/monadChain.ts.
# If you later switch to a keyed provider (QuickNode/Ankr), the keyed URL must be
# consumed SERVER-SIDE only — NEVER prefix an authenticated RPC URL with NEXT_PUBLIC_,
# or the API key ships in client JS to every visitor.
